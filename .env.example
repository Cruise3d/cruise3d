# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres (consumed by the `postgres` and `api` services) ---
# IMPORTANT: Use a strong, high-entropy password for production deployments.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cruise3d

# --- API authentication (server-side, consumed by the `api` service) ---
# Generate a unique high-entropy value; never commit the real key.
JWT_KEY=

# --- Cloudinary (server-side, consumed by the `api` service) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (server-side, consumed by the `api` service) ---
RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- Frontend build args (consumed by the `frontend` and `frontend-dev` services) ---
# Defaults to /api so all API calls are proxied through Nginx on the same host/port.
VITE_API_BASE_URL=/api
VITE_RAZORPAY_KEY_ID=

# --- Public app URL used by the API for web-push click-through links ---
# Local dev can stay on localhost; production should use your real domain.
APP_PUBLIC_URL=https://localhost

# --- Brevo transactional email (server-side, consumed by the `api` service) ---
# Leave the API key empty here and supply it via a secret or environment override.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cruise3D
BREVO_ENABLED_IN_DEVELOPMENT=false

# --- Email verification token policy (server-side, consumed by the `api` service) ---
EMAIL_VERIFICATION_TOKEN_LIFETIME_MINUTES=1440

# --- Firebase (frontend, consumed by the browser app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Firebase Admin SDK (server-side, consumed by the `api` service) ---
FIREBASE_CREDENTIALS_PATH=secrets/firebase-adminsdk.json
