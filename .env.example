# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres (consumed by the `postgres` and `api` services) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=cruise3d

# --- Razorpay (server-side, consumed by the `api` service) ---
RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- Frontend build args (consumed by the `frontend` and `frontend-dev` services) ---
# What the SPA uses when calling the API from the browser. Must point to the
# host-published API port. Defaults to http://localhost:5000/api.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=
