{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": [
      "172.30.0.2"
    ]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 600
    },
    "ResendVerification": {
      "PermitLimit": 3,
      "WindowSeconds": 600
    },
    "VerifyEmail": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "App": {
    "PublicUrl": "https://localhost"
  },
  "Brevo": {
    "ApiKey": "",
    "SenderEmail": "no-reply@cruise3d.com",
    "SenderName": "Cruise3D",
    "EnabledInDevelopment": false
  },
  "EmailVerification": {
    "TokenLifetimeMinutes": 1440,
    "VerificationPath": "/verify-email"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 60,
    "ResetPasswordPath": "/reset-password"
  }
}